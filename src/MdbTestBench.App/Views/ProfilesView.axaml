<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" xmlns:profiles="using:MdbTestBench.Core.Profiles"
             x:Class="MdbTestBench.App.Views.ProfilesView" x:DataType="vm:MainWindowViewModel">
  <Grid Margin="28" ColumnDefinitions="280,*" ColumnSpacing="16">
    <Border Classes="card">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="label" Text="{DynamicResource Profiles}" />
        <ListBox Grid.Row="1" Margin="0,10" ItemsSource="{Binding Profiles.Items}" SelectedItem="{Binding Profiles.Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="profiles:MdbProfile">
              <StackPanel Margin="4,7">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BaseLevel}" FontSize="11" Foreground="#93A1B5" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2">
          <Button Content="{DynamicResource New}" Command="{Binding Profiles.NewCommand}" Margin="0,0,6,6" />
          <Button Content="{DynamicResource Duplicate}" Command="{Binding Profiles.DuplicateCommand}" Margin="0,0,6,6" />
          <Button Classes="danger" Content="{DynamicResource DeleteCustom}" Command="{Binding Profiles.DeleteCommand}" Margin="0,0,6,6" />
        </WrapPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{DynamicResource Name}" />
              <TextBox Text="{Binding Profiles.Editor.Name}" IsReadOnly="{Binding Profiles.Editor.IsBuiltIn}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="label" Text="{DynamicResource BaseFeatureLevel}" />
              <ComboBox ItemsSource="{Binding Profiles.FeatureLevels}" SelectedItem="{Binding Profiles.Editor.BaseLevel}"
                        IsEnabled="{Binding Profiles.Editor.CanEdit}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
              <TextBlock Classes="label" Text="{DynamicResource Description}" />
              <TextBox Text="{Binding Profiles.Editor.Description}" IsReadOnly="{Binding Profiles.Editor.IsBuiltIn}"
                       AcceptsReturn="True" MinHeight="65" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="{DynamicResource CapabilityStatusHelp}"
                       Foreground="#FFD166" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource Capabilities}" />
            <Grid ColumnDefinitions="*,180,*,180" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Text="{DynamicResource Expansion}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.ExpansionOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Revalue}" VerticalAlignment="Center" /><ComboBox Grid.Column="3" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.RevalueOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource RemoteVend}" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.RemoteVendOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource MultiCurrency}" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.MultiCurrencyOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="2" Text="{DynamicResource NegativeVend}" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.NegativeVendOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource DataEntry}" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.DataEntryOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="3" Text="{DynamicResource Basket}" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.BasketOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource Refund}" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding Profiles.CapabilityStatusOptions}" SelectedItem="{Binding Profiles.RefundOption}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding Profiles.Editor.CanEdit}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Classes="primary" Content="{DynamicResource SaveCustom}" Command="{Binding Profiles.SaveCommand}" />
              <Button Content="{DynamicResource ExportJson}" Command="{Binding Profiles.ExportCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource ImportJson}" />
            <TextBox Text="{Binding Profiles.ImportPath}" PlaceholderText="{DynamicResource ProfilePathPlaceholder}" />
            <Button Content="{DynamicResource ImportAsCustom}" Command="{Binding Profiles.ImportCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Profiles.Message}" TextWrapping="Wrap" Foreground="#93A1B5" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
