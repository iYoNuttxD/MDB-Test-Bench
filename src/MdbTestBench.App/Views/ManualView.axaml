<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" x:Class="MdbTestBench.App.Views.ManualView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Padding="28">
    <TabControl>
      <TabItem Header="{DynamicResource Structured}">
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16" Margin="0,18,0,0">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="{DynamicResource SemanticCommand}" />
              <ComboBox ItemsSource="{Binding Manual.CommandOptions}" SelectedItem="{Binding Manual.SelectedCommand}" />
              <TextBlock Classes="label" Text="{DynamicResource CashlessDevice}" />
              <ComboBox ItemsSource="{Binding Manual.DeviceOptions}" SelectedItem="{Binding Manual.SelectedDevice}" />
              <TextBlock Classes="label" Text="{DynamicResource Price}" />
              <TextBox Text="{Binding Manual.Price}" PlaceholderText="{DynamicResource PriceExample}" />
              <TextBlock Classes="label" Text="{DynamicResource ProductNumber}" />
              <TextBox Text="{Binding Manual.Product}" PlaceholderText="{DynamicResource ProductExample}" />
              <TextBlock Classes="label" Text="{DynamicResource CurrencyValue}" />
              <TextBox Text="{Binding Manual.Value}" PlaceholderText="{DynamicResource Optional}" />
              <TextBlock Text="{DynamicResource ManualScaleHelp}" Foreground="#93A1B5" TextWrapping="Wrap" />
              <Button Classes="primary" Content="{DynamicResource SendStructured}" Command="{Binding Manual.SendStructuredCommand}"
                      IsEnabled="{Binding Manual.CanUseStructured}" HorizontalAlignment="Stretch" />
              <TextBlock IsVisible="{Binding IsHardwareSelected}"
                         Text="{DynamicResource StructuredHardwareDisabled}"
                         Foreground="#FFD166" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="{DynamicResource SemanticRawPreview}" />
                <TextBlock Classes="mono" Text="{Binding Manual.Preview}" TextWrapping="Wrap" FontSize="15" />
                <TextBlock Text="{DynamicResource MdbBytesHelp}" Foreground="#FFD166" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="{DynamicResource StateMachine}" />
                <TextBlock Classes="value" Text="{Binding Manual.CurrentState}" />
                <TextBlock Text="{DynamicResource StateMachineHelp}" Foreground="#93A1B5" />
                <TextBlock Text="{Binding Manual.Message}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource AdvancedRawAdapter}">
        <Border Classes="card" Margin="0,18,0,0" MaxWidth="850" HorizontalAlignment="Left">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource AdapterDebug}" Foreground="#FFD166" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource SimulatorRawHelp}"
                       TextWrapping="Wrap" Foreground="#93A1B5" />
            <TextBox Text="{Binding Manual.RawHex}" PlaceholderText="{DynamicResource RawHexExample}" AcceptsReturn="True" MinHeight="90"
                     FontFamily="Menlo,Consolas,monospace" />
            <TextBlock Classes="mono" Text="{Binding Manual.RawValidation}" TextWrapping="Wrap" />
            <CheckBox Content="{DynamicResource ConfirmSimulatorRaw}" IsChecked="{Binding Manual.RawConfirmed}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="{DynamicResource SendSimulatorRaw}" Command="{Binding Manual.SendRawCommand}" IsEnabled="{Binding Manual.CanUseRaw}" />
              <TextBlock Text="{Binding Manual.Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </ScrollViewer>
</UserControl>
