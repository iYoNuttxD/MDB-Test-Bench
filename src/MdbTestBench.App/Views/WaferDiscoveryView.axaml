<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" x:Class="MdbTestBench.App.Views.WaferDiscoveryView"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
            <StackPanel><TextBlock Classes="label" Text="ADAPTER MODEL"/><TextBox Text="{Binding Discovery.AdapterModel}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="PRINTED CODE / REVISION"/><TextBox Text="{Binding Discovery.PrintedRevision}"/></StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="Start Capture" Command="{Binding Discovery.StartCommand}" VerticalAlignment="Bottom"/>
            <Button Grid.Column="3" Content="Stop" Command="{Binding Discovery.StopCommand}" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBox PlaceholderText="Operator notes (unknown values may remain blank)" Text="{Binding Discovery.Notes}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Discovery.Status}" TextWrapping="Wrap" Foreground="#FFD166" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Discovery.CaptureSize, StringFormat='Capture size: {0}'}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="OPERATOR MARKER"/>
          <TextBox Text="{Binding Discovery.MarkerText}" PlaceholderText="e.g. Cashless LED turned on"/>
          <Button Content="Add Marker" Command="{Binding Discovery.AddMarkerCommand}"/>
          <TextBlock Text="Markers correlate physical observations with monotonic timing." Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,180" ColumnSpacing="8">
            <CheckBox Content="TX" IsChecked="{Binding Discovery.ShowTx}"/>
            <CheckBox Grid.Column="1" Content="RX" IsChecked="{Binding Discovery.ShowRx}"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Discovery.DisplayModes}" SelectedItem="{Binding Discovery.DisplayMode}"/>
            <TextBox Grid.Column="4" Text="{Binding Discovery.Search}" PlaceholderText="Search capture"/>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Discovery.Events}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WaferCaptureEventViewModel">
                <Border BorderBrush="#273348" BorderThickness="0,0,0,1" Padding="4,7">
                  <StackPanel>
                    <TextBlock><Run Text="{Binding Timestamp}"/><Run Text="  "/><Run Text="{Binding Direction}" FontWeight="Bold"/></TextBlock>
                    <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Menlo, Consolas, monospace" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.65"/>
                    <TextBlock Text="{Binding Interpretation}" FontSize="11" Foreground="#FFD166"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="RAW ADAPTER / WAFER DEBUG" Foreground="#FFD166" FontWeight="Bold"/>
              <TextBlock Text="Not Raw MDB. Wire format and terminator come from Settings." Opacity="0.7" TextWrapping="Wrap"/>
              <TextBox Text="{Binding Discovery.RawHex}" PlaceholderText="10 or 31 30" FontFamily="Cascadia Mono, Menlo, Consolas, monospace"/>
              <TextBlock Text="{Binding Discovery.RawValidation}" FontSize="11"/>
              <CheckBox Content="I reviewed and confirm these exact adapter bytes" IsChecked="{Binding Discovery.RawConfirmed}"/>
              <Button Content="Send Raw Adapter" Command="{Binding Discovery.SendRawCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="MANUAL PROBES (NEVER AUTO-RUN)"/>
              <TextBox Text="{Binding Discovery.ProbeName}" PlaceholderText="Probe name"/>
              <TextBox Text="{Binding Discovery.ProbeNotes}" PlaceholderText="Evidence/source notes"/>
              <Button Content="Save current HEX as probe" Command="{Binding Discovery.SaveProbeCommand}"/>
              <ComboBox ItemsSource="{Binding Discovery.Probes}" SelectedItem="{Binding Discovery.SelectedProbe}" DisplayMemberBinding="{Binding Name}"/>
              <Button Content="Load selected probe for review" Command="{Binding Discovery.SendProbeCommand}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="OFFLINE ANALYSIS / SHARE"/>
          <TextBlock Text="{Binding Discovery.Analysis}" TextWrapping="Wrap"/>
          <TextBox Text="{Binding Discovery.CapturePath}" PlaceholderText="Path to open, or generated export path"/>
          <TextBlock Text="This file contains raw serial communication and timing data. Review before sharing." Foreground="#FFD166"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <Button Classes="primary" Content="Export for Analysis" Command="{Binding Discovery.ExportCommand}"/>
          <Button Content="Open Capture" Command="{Binding Discovery.OpenCommand}"/>
          <Button Content="Export TXT Summary" Command="{Binding Discovery.ExportSummaryCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
