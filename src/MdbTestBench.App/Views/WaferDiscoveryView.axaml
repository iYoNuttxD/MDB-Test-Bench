<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" x:Class="MdbTestBench.App.Views.WaferDiscoveryView"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
            <StackPanel><TextBlock Classes="label" Text="{DynamicResource AdapterModel}"/><TextBox Text="{Binding Discovery.AdapterModel}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="{DynamicResource PrintedRevision}"/><TextBox Text="{Binding Discovery.PrintedRevision}"/></StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="{DynamicResource StartCapture}" Command="{Binding Discovery.StartCommand}" VerticalAlignment="Bottom"/>
            <Button Grid.Column="3" Content="{DynamicResource Stop}" Command="{Binding Discovery.StopCommand}" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBox PlaceholderText="{DynamicResource OperatorNotesPlaceholder}" Text="{Binding Discovery.Notes}"/>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border Background="#493B13" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding Discovery.OperationMode}" Foreground="#FFD166" FontWeight="Bold"/></Border>
            <TextBlock Grid.Column="1" Text="{Binding Discovery.Status}" TextWrapping="Wrap" Foreground="#FFD166" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center"><Run Text="{DynamicResource CaptureSizeLabel}"/><Run Text=": "/><Run Text="{Binding Discovery.CaptureSize}"/></TextBlock>
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{DynamicResource OperatorMarker}"/>
          <TextBox Text="{Binding Discovery.MarkerText}" PlaceholderText="{DynamicResource MarkerPlaceholder}"/>
          <Button Content="{DynamicResource AddMarker}" Command="{Binding Discovery.AddMarkerCommand}"/>
          <TextBlock Text="{DynamicResource MarkerHelp}" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,180" ColumnSpacing="8">
            <CheckBox Content="{DynamicResource Tx}" IsChecked="{Binding Discovery.ShowTx}"/>
            <CheckBox Grid.Column="1" Content="{DynamicResource Rx}" IsChecked="{Binding Discovery.ShowRx}"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Discovery.DisplayModes}" SelectedItem="{Binding Discovery.DisplayMode}"/>
            <TextBox Grid.Column="4" Text="{Binding Discovery.Search}" PlaceholderText="{DynamicResource SearchCapture}"/>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Discovery.Events}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WaferCaptureEventViewModel">
                <Border BorderBrush="#273348" BorderThickness="0,0,0,1" Padding="4,7">
                  <StackPanel>
                    <TextBlock><Run Text="{Binding Timestamp}"/><Run Text="  "/><Run Text="{Binding Direction}" FontWeight="Bold"/></TextBlock>
                    <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Menlo, Consolas, monospace" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.65"/>
                    <TextBlock Text="{Binding Interpretation}" FontSize="11" Foreground="#FFD166"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource RawAdapterDebug}" Foreground="#FFD166" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource RawAdapterHelp}" Opacity="0.7" TextWrapping="Wrap"/>
              <TextBox Text="{Binding Discovery.RawHex}" PlaceholderText="{DynamicResource AdapterHexExample}" FontFamily="Cascadia Mono, Menlo, Consolas, monospace"/>
              <TextBlock Text="{Binding Discovery.RawValidation}" FontSize="11" Foreground="#FFD166" TextWrapping="Wrap"/>
              <CheckBox Content="{DynamicResource ConfirmAdapterBytes}" IsChecked="{Binding Discovery.RawConfirmed}"/>
              <Button Content="{DynamicResource SendRawAdapter}" Command="{Binding Discovery.SendRawCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{DynamicResource ManualProbes}"/>
              <TextBox Text="{Binding Discovery.ProbeName}" PlaceholderText="{DynamicResource ProbeName}"/>
              <TextBox Text="{Binding Discovery.ProbeNotes}" PlaceholderText="{DynamicResource ProbeNotes}"/>
              <Button Content="{DynamicResource SaveProbe}" Command="{Binding Discovery.SaveProbeCommand}"/>
              <ComboBox ItemsSource="{Binding Discovery.Probes}" SelectedItem="{Binding Discovery.SelectedProbe}" DisplayMemberBinding="{Binding Name}"/>
              <Button Content="{DynamicResource LoadProbe}" Command="{Binding Discovery.SendProbeCommand}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{DynamicResource OfflineAnalysisShare}"/>
          <TextBlock Text="{Binding Discovery.Analysis}" TextWrapping="Wrap"/>
          <TextBox Text="{Binding Discovery.CapturePath}" PlaceholderText="{DynamicResource CapturePathPlaceholder}"/>
          <TextBlock Text="{DynamicResource ShareWarning}" Foreground="#FFD166"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <Button Classes="primary" Content="{DynamicResource ExportForAnalysis}" Command="{Binding Discovery.ExportCommand}"/>
          <Button Content="{DynamicResource OpenCapture}" Command="{Binding Discovery.OpenCommand}"/>
          <Button Content="{DynamicResource ExportTxtSummary}" Command="{Binding Discovery.ExportSummaryCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
