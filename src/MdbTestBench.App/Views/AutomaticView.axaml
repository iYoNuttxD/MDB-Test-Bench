<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" x:Class="MdbTestBench.App.Views.AutomaticView"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="28" ColumnDefinitions="310,*" ColumnSpacing="16">
    <Border Classes="card">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="label" Text="{DynamicResource BuiltInScenarios}" />
        <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Automatic.Scenarios}" SelectedItem="{Binding Automatic.Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ScenarioDisplayViewModel">
              <StackPanel Margin="4,7" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RequiredProfile}" FontSize="11" Foreground="#93A1B5" />
                <TextBlock Text="{Binding Result}" FontSize="11" Foreground="#75B8FF" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="value" Text="{Binding Automatic.Selected.Name}" />
            <TextBlock Text="{Binding Automatic.Selected.Description}" TextWrapping="Wrap" Foreground="#93A1B5" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="{DynamicResource RunScenario}" Command="{Binding Automatic.RunCommand}" />
              <Button Content="{DynamicResource Cancel}" Command="{Binding Automatic.CancelCommand}" IsEnabled="{Binding Automatic.IsRunning}" />
              <TextBlock Text="{Binding Automatic.Selected.Result}" VerticalAlignment="Center" FontWeight="Bold" />
              <TextBlock Text="{Binding Automatic.Selected.Duration}" VerticalAlignment="Center" Foreground="#93A1B5" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="45,*,100,150" Margin="0,0,0,7">
              <TextBlock Classes="label" Text="{DynamicResource Number}" />
              <TextBlock Grid.Column="1" Classes="label" Text="{DynamicResource Step}" />
              <TextBlock Grid.Column="2" Classes="label" Text="{DynamicResource Result}" />
              <TextBlock Grid.Column="3" Classes="label" Text="{DynamicResource Received}" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Automatic.Selected.Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScenarioStepDisplayViewModel">
                  <Grid ColumnDefinitions="45,*,100,150" Margin="0,5">
                    <TextBlock Classes="mono" Text="{Binding NumberText}" Foreground="#93A1B5" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Status}" />
                    <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Received}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="22">
            <TextBlock><Run Text="{DynamicResource Total}"/><Run Text="  "/><Run Text="{Binding Automatic.Selected.Steps.Count}"/></TextBlock>
            <TextBlock Grid.Column="1" Foreground="#41C97A"><Run Text="{DynamicResource Passes}"/><Run Text="  "/><Run Text="{Binding Automatic.Passes}"/></TextBlock>
            <TextBlock Grid.Column="2" Foreground="#F08A91"><Run Text="{DynamicResource Failures}"/><Run Text="  "/><Run Text="{Binding Automatic.Failures}"/></TextBlock>
            <TextBlock Grid.Column="3" Text="{Binding Automatic.Summary}" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
