<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels" x:Class="MdbTestBench.App.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Padding="28">
    <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Left">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto">
          <StackPanel>
            <TextBlock Classes="label" Text="{DynamicResource Transport}" />
            <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransportOption}"
                      DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding CanChangeTransport}" />
          </StackPanel>
          <StackPanel Grid.Column="1" IsVisible="{Binding IsSimulationSelected}">
            <TextBlock Classes="label" Text="{DynamicResource SimulatorBehavior}" />
            <ComboBox ItemsSource="{Binding SimulatorBehaviorOptions}" SelectedItem="{Binding SelectedSimulatorBehaviorOption}" DisplayMemberBinding="{Binding DisplayName}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Classes="label" Text="{DynamicResource PollingMode}" />
            <ComboBox ItemsSource="{Binding PollingModeOptions}" SelectedItem="{Binding SelectedPollingModeOption}" DisplayMemberBinding="{Binding DisplayName}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
            <TextBlock Classes="label" Text="{DynamicResource TimeoutMilliseconds}" />
            <NumericUpDown Value="{Binding TimeoutMilliseconds}" Minimum="50" Maximum="120000" Increment="50" />
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Classes="label" Text="{DynamicResource CaptureLimitMegabytes}" />
            <NumericUpDown Value="{Binding CaptureMaximumMegabytes}" Minimum="1" Maximum="1024" Increment="10" />
          </StackPanel>
          <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsSimulationSelected}" Background="#493B13" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource SimulationExplicitHelp}"
                       Foreground="#FFD166" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsHardwareSelected}">
        <StackPanel Spacing="12">
          <TextBlock Classes="label" Text="{DynamicResource SerialWaferTitle}" />
          <TextBlock Text="{DynamicResource SerialSafetyHelp}"
                     Foreground="#FFD166" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" PlaceholderText="{DynamicResource NoPortSelected}" />
            <Button Grid.Column="1" Content="{DynamicResource RefreshPorts}" Command="{Binding RefreshPortsCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
            <StackPanel><TextBlock Classes="label" Text="{DynamicResource BaudRate}" /><ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding SelectedBaudRate}" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="{DynamicResource DataBits}" /><ComboBox ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding SelectedDataBits}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="{DynamicResource Parity}" /><ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParityOption}" DisplayMemberBinding="{Binding DisplayName}" /></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Classes="label" Text="{DynamicResource StopBits}" /><ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBitsOption}" DisplayMemberBinding="{Binding DisplayName}" /></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Classes="label" Text="{DynamicResource Handshake}" /><ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding SelectedHandshakeOption}" DisplayMemberBinding="{Binding DisplayName}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsHardwareSelected}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource AdapterDebug}" Foreground="#FFD166" FontWeight="Bold" />
          <TextBlock Text="{DynamicResource AdapterDebugHelp}"
                     TextWrapping="Wrap" Foreground="#93A1B5" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel><TextBlock Classes="label" Text="{DynamicResource WireFormat}" /><ComboBox ItemsSource="{Binding WireFormatOptions}" SelectedItem="{Binding SelectedWireFormatOption}" DisplayMemberBinding="{Binding DisplayName}" /></StackPanel>
            <StackPanel Grid.Column="1" IsVisible="{Binding IsAsciiHex}"><TextBlock Classes="label" Text="{DynamicResource AsciiHexTerminator}" /><ComboBox ItemsSource="{Binding TerminatorOptions}" SelectedItem="{Binding SelectedTerminatorOption}" DisplayMemberBinding="{Binding DisplayName}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="{DynamicResource ConnectionLifecycle}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{DynamicResource Connect}" Command="{Binding ConnectCommand}" />
            <Button Content="{DynamicResource Disconnect}" Command="{Binding DisconnectCommand}" />
            <Button Content="{DynamicResource SaveSettings}" Command="{Binding SaveSettingsCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
          <TextBlock Foreground="#F08A91" TextWrapping="Wrap"><Run Text="{DynamicResource LastErrorLabel}"/><Run Text=" "/><Run Text="{Binding LastError}"/></TextBlock>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource Language}" />
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}" DisplayMemberBinding="{Binding DisplayName}" />
            <TextBlock Text="{DynamicResource LanguageImmediateHelp}" Foreground="#93A1B5" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Classes="label" Text="{DynamicResource About}" />
            <TextBlock Classes="value" Text="{Binding AboutProduct}" />
            <TextBlock Text="{Binding AboutRuntime}" />
            <TextBlock Text="{Binding AboutSystem}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
