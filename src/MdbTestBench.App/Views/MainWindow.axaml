<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MdbTestBench.App.ViewModels"
        xmlns:views="using:MdbTestBench.App.Views"
        x:Class="MdbTestBench.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MDB Test Bench"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="920"
        MinHeight="620">
  <Grid ColumnDefinitions="220,*">
    <Border Background="#151E2C" Padding="18">
      <Grid RowDefinitions="Auto,28,*,Auto">
        <StackPanel>
          <TextBlock Text="MDB TEST BENCH" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="VMC / cashless validation · v0.1.1" Opacity="0.58" FontSize="11" />
        </StackPanel>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Pages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <Button Content="{Binding Title}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                      CommandParameter="{Binding}"
                      HorizontalContentAlignment="Left"
                      Margin="0,0,0,7" Padding="13,10" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="3" Spacing="4">
          <Border IsVisible="{Binding ShowSimulationBanner}" Background="#493B13" CornerRadius="5" Padding="8,5">
            <TextBlock Text="SIMULATION" Foreground="#FFD166" FontWeight="Bold" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Padding="28,20,28,15" BorderBrush="#273348" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding SelectedPage.Title}" FontSize="27" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedPage.Description}" Foreground="#93A1B5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="{Binding ConnectionColor}" />
            <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <views:DashboardView IsVisible="{Binding IsDashboardVisible}" />
        <views:ManualView IsVisible="{Binding IsManualVisible}" />
        <views:AutomaticView IsVisible="{Binding IsAutomaticVisible}" />
        <views:ProfilesView IsVisible="{Binding IsProfilesVisible}" />
        <views:LogsView IsVisible="{Binding IsLogsVisible}" />
        <views:WaferDiscoveryView IsVisible="{Binding IsWaferDiscoveryVisible}" />
        <views:SettingsView IsVisible="{Binding IsSettingsVisible}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
