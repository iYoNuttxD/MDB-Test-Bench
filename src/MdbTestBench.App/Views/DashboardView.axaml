<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels"
             x:Class="MdbTestBench.App.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Padding="28">
    <StackPanel Spacing="16">
      <Border IsVisible="{Binding ShowSimulationBanner}" Background="#493B13" CornerRadius="8" Padding="14">
        <TextBlock Text="{DynamicResource SimulationDashboardHelp}"
                   Foreground="#FFD166" FontWeight="Bold" />
      </Border>
      <WrapPanel ItemWidth="275" ItemHeight="190">
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource Connection}" />
            <TextBlock Classes="value" Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionColor}" />
            <TextBlock><Run Text="{DynamicResource PortLabel}"/><Run Text="  ·  "/><Run Text="{Binding PortDisplay}"/></TextBlock>
            <TextBlock><Run Text="{DynamicResource TransportLabel}"/><Run Text="  ·  "/><Run Text="{Binding TransportDisplay}"/></TextBlock>
            <TextBlock><Run Text="{DynamicResource PollingLabel}"/><Run Text="  ·  "/><Run Text="{Binding PollingDisplay}"/></TextBlock>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource DeviceUnderTest}" />
            <TextBlock Classes="value" Text="{DynamicResource CashlessDevice1}" />
            <TextBlock><Run Text="{DynamicResource MdbAddressLabel}"/><Run Text="  ·  0x10"/></TextBlock>
            <TextBlock><Run Text="{DynamicResource DetectedLevelLabel}"/><Run Text="  ·  "/><Run Text="{Binding DetectedFeatureLevel}"/></TextBlock>
            <TextBlock><Run Text="{DynamicResource CurrentStateLabel}"/><Run Text="  ·  "/><Run Text="{Binding CurrentState}"/></TextBlock>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource ActiveProfile}" />
            <TextBlock Classes="value" Text="{Binding ActiveProfileName}" />
            <TextBlock Text="{Binding ActiveFeatureLevel}" Foreground="#75B8FF" />
            <TextBlock Text="{DynamicResource CapabilitiesIndependent}" TextWrapping="Wrap" Foreground="#93A1B5" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource Session}" />
            <TextBlock Classes="value" Text="{Binding CurrentState}" />
            <TextBlock><Run Text="{DynamicResource LastCommandLabel}"/><Run Text="  ·  "/><Run Text="{Binding Manual.LastCommand}"/></TextBlock>
            <TextBlock><Run Text="{DynamicResource LastResponseLabel}"/><Run Text="  ·  "/><Run Text="{Binding Manual.LastResponse}"/></TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="#F08A91"><Run Text="{DynamicResource ErrorsLabel}"/><Run Text="  ·  "/><Run Text="{Binding LastError}"/></TextBlock>
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Classes="label" Text="{DynamicResource ProtocolSupport}" />
          <ItemsControl ItemsSource="{Binding ProtocolSupport}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProtocolSupportViewModel">
                <Grid ColumnDefinitions="90,*,*,*,1.4*" Margin="0,4">
                  <TextBlock Text="{Binding FeatureLevel}" FontWeight="Bold" />
                  <TextBlock Grid.Column="1"><Run Text="{DynamicResource EncoderLabel}"/><Run Text=": "/><Run Text="{Binding Encoder}"/></TextBlock>
                  <TextBlock Grid.Column="2"><Run Text="{DynamicResource DecoderLabel}"/><Run Text=": "/><Run Text="{Binding Decoder}"/></TextBlock>
                  <TextBlock Grid.Column="3"><Run Text="{DynamicResource SimulatorLabel}"/><Run Text=": "/><Run Text="{Binding Simulator}"/></TextBlock>
                  <TextBlock Grid.Column="4" Foreground="#FFD166"><Run Text="{DynamicResource HardwareLabel}"/><Run Text=": "/><Run Text="{Binding Hardware}"/></TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{DynamicResource ProtocolSupportHelp}" Foreground="#93A1B5" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="label" Text="{DynamicResource LiveTraffic}" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs.LiveTraffic}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid ColumnDefinitions="122,42,155,*" Margin="0,3">
                  <TextBlock Classes="mono" Text="{Binding Timestamp}" Foreground="#93A1B5" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Direction}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Command}" FontWeight="SemiBold" Margin="4,0,0,0" />
                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
