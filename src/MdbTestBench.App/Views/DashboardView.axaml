<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdbTestBench.App.ViewModels"
             x:Class="MdbTestBench.App.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Padding="28">
    <StackPanel Spacing="16">
      <Border IsVisible="{Binding ShowSimulationBanner}" Background="#493B13" CornerRadius="8" Padding="14">
        <TextBlock Text="SIMULATION — responses come from SimulatedCashlessTransport, not physical hardware."
                   Foreground="#FFD166" FontWeight="Bold" />
      </Border>
      <WrapPanel ItemWidth="275" ItemHeight="190">
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="CONNECTION" />
            <TextBlock Classes="value" Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionColor}" />
            <TextBlock Text="{Binding PortDisplay, StringFormat='Port  ·  {0}'}" />
            <TextBlock Text="{Binding TransportDisplay, StringFormat='Transport  ·  {0}'}" />
            <TextBlock Text="{Binding PollingDisplay, StringFormat='Polling  ·  {0}'}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="DEVICE UNDER TEST" />
            <TextBlock Classes="value" Text="Cashless device 1" />
            <TextBlock Text="MDB address  ·  0x10" />
            <TextBlock Text="{Binding DetectedFeatureLevel, StringFormat='Detected level  ·  {0}'}" />
            <TextBlock Text="{Binding CurrentState, StringFormat='Current state  ·  {0}'}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="ACTIVE PROFILE" />
            <TextBlock Classes="value" Text="{Binding ActiveProfileName}" />
            <TextBlock Text="{Binding ActiveFeatureLevel}" Foreground="#75B8FF" />
            <TextBlock Text="Capabilities are declared independently." TextWrapping="Wrap" Foreground="#93A1B5" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,14,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="SESSION" />
            <TextBlock Classes="value" Text="{Binding CurrentState}" />
            <TextBlock Text="{Binding Manual.LastCommand, StringFormat='Last command  ·  {0}'}" />
            <TextBlock Text="{Binding Manual.LastResponse, StringFormat='Last response  ·  {0}'}" />
            <TextBlock Text="{Binding LastError, StringFormat='Errors  ·  {0}'}" TextWrapping="Wrap" Foreground="#F08A91" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Classes="label" Text="PROTOCOL SUPPORT · MDB CASHLESS" />
          <ItemsControl ItemsSource="{Binding ProtocolSupport}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProtocolSupportViewModel">
                <Grid ColumnDefinitions="90,*,*,*,1.4*" Margin="0,4">
                  <TextBlock Text="{Binding FeatureLevel}" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding Encoder, StringFormat='Encoder: {0}'}" />
                  <TextBlock Grid.Column="2" Text="{Binding Decoder, StringFormat='Decoder: {0}'}" />
                  <TextBlock Grid.Column="3" Text="{Binding Simulator, StringFormat='Simulator: {0}'}" />
                  <TextBlock Grid.Column="4" Text="{Binding Hardware, StringFormat='Hardware: {0}'}" Foreground="#FFD166" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Feature Level does not enable every capability. Hardware status refers only to the unvalidated Wafer adapter layer." Foreground="#93A1B5" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="label" Text="LIVE TRAFFIC · LAST 8 EVENTS" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs.LiveTraffic}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid ColumnDefinitions="122,42,155,*" Margin="0,3">
                  <TextBlock Classes="mono" Text="{Binding Timestamp}" Foreground="#93A1B5" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Direction}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Command}" FontWeight="SemiBold" Margin="4,0,0,0" />
                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
